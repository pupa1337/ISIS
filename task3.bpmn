<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:process id="Process_Cats" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_View</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Related</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildCard</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DB" name="База данных">
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Found</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Input" name="Ввод поискового запроса">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_Err_Back</bpmn:incoming>
      <bpmn:incoming>Flow_NotF_Back</bpmn:incoming>
      <bpmn:incoming>Flow_Rel_Back</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_View" name="Просмотр информации">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MoreInfo" name="Нужна доп. информация?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_11_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Related" name="Переход по связанным разделам">
      <bpmn:incoming>Flow_11_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Rel_Back</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Процесс завершён">
      <bpmn:incoming>Flow_11_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Input" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Input" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ShowResult" targetRef="Task_View" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_View" targetRef="Gateway_MoreInfo" />
    <bpmn:sequenceFlow id="Flow_11_Yes" name="Да" sourceRef="Gateway_MoreInfo" targetRef="Task_Related" />
    <bpmn:sequenceFlow id="Flow_11_No" name="Нет" sourceRef="Gateway_MoreInfo" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Rel_Back" sourceRef="Task_Related" targetRef="Task_Input" />
    <bpmn:serviceTask id="Task_Validate" name="Проверка корректности запроса">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Запрос корректен?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_4_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Error" name="Вывод сообщения об ошибке">
      <bpmn:incoming>Flow_4_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Err_Back</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Search" name="Поиск в БД">
      <bpmn:incoming>Flow_4_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotFound" name="Сообщение «Не найдено»">
      <bpmn:incoming>Flow_7_No</bpmn:incoming>
      <bpmn:outgoing>Flow_NotF_Back</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BuildCard" name="Формирование карточки породы">
      <bpmn:incoming>Flow_7_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ShowResult" name="Отображение результата">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_4_Yes" name="Да" sourceRef="Gateway_Valid" targetRef="Task_Search" />
    <bpmn:sequenceFlow id="Flow_4_No" name="Нет" sourceRef="Gateway_Valid" targetRef="Task_Error" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Search" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_BuildCard" targetRef="Task_ShowResult" />
    <bpmn:serviceTask id="Task_Select" name="Выборка данных">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Found" name="Данные найдены?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_7_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Select" targetRef="Gateway_Found" />
    <bpmn:sequenceFlow id="Flow_7_Yes" name="Да" sourceRef="Gateway_Found" targetRef="Task_BuildCard" />
    <bpmn:sequenceFlow id="Flow_7_No" name="Нет" sourceRef="Gateway_Found" targetRef="Task_NotFound" />
    <bpmn:sequenceFlow id="Flow_Err_Back" sourceRef="Task_Error" targetRef="Task_Input" />
    <bpmn:sequenceFlow id="Flow_NotF_Back" sourceRef="Task_NotFound" targetRef="Task_Input" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Cats">
      <bpmndi:BPMNShape id="Lane_DB_di" bpmnElement="Lane_DB" isHorizontal="true">
        <dc:Bounds x="130" y="560" width="1300" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="130" y="320" width="1300" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="1300" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="182" width="36" height="36" />
