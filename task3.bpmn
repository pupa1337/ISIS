        <bpmndi:BPMNLabel>
          <dc:Bounds x="640" y="422" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="730" y="550" />
        <di:waypoint x="730" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1020" y="440" />
        <di:waypoint x="1140" y="440" />
      </bpmndi:BPMNEdge>
